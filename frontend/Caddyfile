{$SITE_ADDRESS} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    @api path /api /api/*
    handle @api {
        uri strip_prefix /api
        reverse_proxy backend:3354
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
