# Use a domain/subdomain pointing at the VM for automatic public HTTPS.
SITE_ADDRESS=mymangatracker.your-domain.example
PUBLIC_ORIGIN=https://mymangatracker.your-domain.example
# Generate distinct random hexadecimal values locally; never commit this file with values.
POSTGRES_PASSWORD=
JWT_SECRET=
# Optional notification delivery. Leave blank until configured; worker is opt-in.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=noreply@example.invalid
